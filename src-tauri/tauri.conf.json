{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tatpar",
  "version": "0.1.0",
  "identifier": "com.mohit.tatpar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tatpar",
        "width": 600,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A floating, persistent code scratchpad that runs anywhere",
    "longDescription": "Tatpar is a lightweight, always-available floating code editor that lets you write and execute snippets in 6 languages without project setup.",
    "copyright": "Copyright © 2024 Mohit",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}