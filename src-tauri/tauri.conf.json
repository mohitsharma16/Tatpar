{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tatpar",
  "version": "0.1.0",
  "identifier": "com.mohit.tatpar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tatpar",
        "width": 600,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}